import os

# Output matches the repository's lib folder
builder.SetBuildFolder('lib')

folder_map = {}
for task in HL2SDK.libs:
  if task.target.platform == 'windows':
    folder = os.path.join('public', 'win64')
  else:
    folder = 'linux64'
  if folder not in folder_map:
    folder_map[folder] = builder.AddFolder(folder)
  builder.AddCopy(task.binary, folder_map[folder])

# The headers generated for the protobufs library
if HL2SDK.protobuf_headers:
  protobufs_folder = builder.AddFolder('protobufs')
  for header in HL2SDK.protobuf_headers:
    builder.AddCopy(header, protobufs_folder)
